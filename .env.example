# Environment Variables for Mohamed Tayal Portfolio
# Copy this file to .env and fill in the values

# PostgreSQL connection string (Neon / Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-random-64-byte-hex-string"

# Admin credentials for seeding
ADMIN_EMAIL="admin@mohamed.dev"
ADMIN_PASSWORD="your-secure-password"

# Resend API key (for email notifications)
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Email to receive contact notifications
NOTIFY_EMAIL="mota200615@gmail.com"

# Allowed origin for CORS (your production domain)
ALLOWED_ORIGIN="https://tayalz.vercel.app"
